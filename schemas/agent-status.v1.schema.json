{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jrausercisco/trmnl-agent-bridge/schemas/agent-status.v1.schema.json",
  "title": "TRMNL Agent Status Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "state",
    "headline",
    "detail",
    "updated"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "maxLength": 40
    },
    "state": {
      "type": "string",
      "enum": ["CLEAR", "WATCH", "ACTION", "BLOCKED", "FAIL"]
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "next": {
      "type": "string",
      "maxLength": 120
    },
    "signals": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "health": {
      "type": "string",
      "maxLength": 140
    },
    "run_url": {
      "type": "string",
      "maxLength": 200
    },
    "repo": {
      "type": "string",
      "maxLength": 120
    },
    "branch": {
      "type": "string",
      "maxLength": 120
    },
    "task": {
      "type": "string",
      "maxLength": 120
    },
    "expires_at": {
      "type": "string",
      "maxLength": 80
    }
  }
}
